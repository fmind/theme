body {
	--color-ui: #ffffff;
	--color-back: #f1f3f4;
	--color-dark: #f1f3f4;
	--color-border: #9aa0a6;
	--color-selected: #d2e3fc;
	--color-elevated: #ffffff;
	--color-button: #f1f3f4;
	--color-bright_ui: #ffffff;
	--color-accent: #174ea6;
	--color-frame: #f1f3f4;
	--color-text: #202124;
	--color-light: #202124;
	--color-accent_text: #ffffff;
	--color-bright_ui_text: #202124;
	--color-subtle_text: #595d62;
	--color-grid: #9aa0a6;
	--color-wireframe: #595d62;
	--color-checkerboard: #f1f3f4;
}
