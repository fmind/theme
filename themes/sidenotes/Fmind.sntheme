{
  "$schema": "https://www.apptorium.com/schemas/sntheme.json",
  "any": {
    "systemAppearance": "light",
    "folders": {
      "header": {
        "backgroundColor": "#ffffff",
        "textColor": "#202124",
        "buttonColor": "#174ea6"
      },
      "list": {
        "backgroundColor": "#ffffff",
        "textColor": "#202124",
        "secondaryTextColor": "#595d62",
        "buttonColor": "#174ea6"
      }
    },
    "folder": {
      "header": {
        "backgroundColor": "#ffffff",
        "textColor": "#202124",
        "buttonColor": "#174ea6"
      },
      "notes": {
        "clean": {
          "backgroundColor": "#ffffff",
          "textColor": "#202124",
          "secondaryTextColor": "#595d62",
          "tertiaryTextColor": "#595d62",
          "linkColor": "#174ea6",
          "buttonColor": "#174ea6"
        }
      }
    }
  }
}
