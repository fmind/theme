# Fmind theme for SmartGit
# Keys from SmartGit's bundled light-theme.properties (smartgit.jar); see `--write-default-theme-file`.
extends=smartgit-light-theme.properties
preferredEditorTheme=light

background1=#ffffff
foreground1=#202124
background2=#f1f3f4
foreground2=#202124

selection.background=#d2e3fc
selection.foreground=#202124
