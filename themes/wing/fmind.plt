# Fmind palette for Wing Python IDE.
# Keys follow the palettes Wing has bundled since Wing 7, such as Dracula:
# https://github.com/dracula/wing/blob/master/palettes/dracula.plt
name: Fmind

# Interface colors, used when the display theme matches the palette
background: #ffffff
foreground: #202124

# Editor colors; each can be overridden in Preferences
editor-background: #ffffff
selection: #d2e3fc
occurrence: #feefc3
caret: #4285f4
caret-highlight: #f1f3f4
brace-highlight: #0d652d
brace-highlight-background: #ceead6
brace-badlight: #a50e0e
brace-badlight-background: #fad2cf
edge-marker: #9aa0a6
fold-mark-foreground: #595d62
fold-mark-background: #ffffff
code-error: #a50e0e
code-warning: #934900
selected-item-background: #d2e3fc
selected-item-foreground: #202124

# Documentation colors
title: #174ea6
link: #174ea6
strong: #202124
literal: #174ea6
error: #a50e0e
warning: #934900
info: #00636d
