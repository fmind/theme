# Openbox Fmind Light Theme

# Menu
menu.border.width: 1
menu.border.color: #f1f3f4
menu.separator.color: #f1f3f4

menu.title.bg: flat solid
menu.title.bg.color: #f1f3f4
menu.title.text.color: #174ea6
menu.title.text.justify: Center

menu.items.bg: flat solid
menu.items.bg.color: #ffffff
menu.items.text.color: #202124

menu.items.active.bg: flat solid
menu.items.active.bg.color: #d2e3fc
menu.items.active.text.color: #202124

# Window
window.active.border.color: #174ea6
window.inactive.border.color: #f1f3f4

window.active.title.bg: flat solid
window.active.title.bg.color: #ffffff
window.active.label.text.color: #202124

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #f1f3f4
window.inactive.label.text.color: #595d62

# Openbox paints unset labels, buttons, handles and grips solid black.
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative

window.active.button.unpressed.bg: parentrelative
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #d2e3fc
window.active.button.disabled.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #d2e3fc
window.inactive.button.disabled.bg: parentrelative

window.active.button.unpressed.image.color: #202124
window.active.button.disabled.image.color: #9aa0a6
window.inactive.button.unpressed.image.color: #595d62
window.inactive.button.disabled.image.color: #9aa0a6

window.active.handle.bg: flat solid
window.active.handle.bg.color: #ffffff
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #f1f3f4
window.active.grip.bg: flat solid
window.active.grip.bg.color: #f1f3f4
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #f1f3f4

menu.items.disabled.text.color: #595d62
