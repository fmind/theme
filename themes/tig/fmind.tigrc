# Fmind theme for tig
# https://github.com/jonas/tig/blob/master/doc/tigrc.5.adoc
# tig accepts only ANSI color names or numbers; pair it with the Fmind terminal palette.
# "#" starts a comment in tigrc, so hex colors cannot be used.
set git-colors = no

color default         default   default
color cursor          blue      default   reverse
color cursor-blur     black     default   reverse
color search-result   yellow    default   reverse
color line-number     color8    default
color title-focus     blue      default   reverse
color title-blur      color8    default   reverse
color header          blue      default
color section         blue      default
color date            color8    default
color author          blue      default
color diff-stat       blue      default
color diff-add        green     default
color diff-del        red       default
