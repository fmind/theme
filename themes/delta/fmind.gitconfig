# https://dandavison.github.io/delta/configuration.html
# Include from ~/.gitconfig, or paste into its [delta] section.

[delta]
    light = true
    syntax-theme = "fmind"
    # Neutral line backgrounds keep +/- markers as the non-color cue.
    keep-plus-minus-markers = true
    minus-style = syntax "#f1f3f4"
    minus-emph-style = bold syntax "#fad2cf"
    minus-empty-line-marker-style = normal "#fad2cf"
    plus-style = syntax "#f1f3f4"
    plus-emph-style = bold syntax "#ceead6"
    plus-empty-line-marker-style = normal "#ceead6"
    whitespace-error-style = "#ffffff" "#a50e0e"
    blame-palette = "#ffffff" "#f1f3f4" "#d2e3fc"
    hunk-header-style = "#595d62"
    file-style = "#174ea6"
    line-numbers-minus-style = "#a50e0e"
    line-numbers-plus-style = "#0d652d"
    line-numbers-zero-style = "#595d62"
    line-numbers-left-style = "#595d62"
    line-numbers-right-style = "#595d62"
    grep-file-style = bold "#174ea6"
    grep-line-number-style = "#595d62"
    grep-match-bar-style = "#feefc3"
    grep-match-word-style = bold "#202124" "#feefc3"
