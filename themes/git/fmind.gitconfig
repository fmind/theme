# Git color configuration
# https://git-scm.com/docs/git-config#_color

[color]
	ui = true
[color "diff"]
	meta = "#595d62"
	frag = "#174ea6"
	old = "#a50e0e"
	new = "#0d652d"
	# Solid red cell: whitespace errors have no glyph, so the background is the cue.
	whitespace = "#ffffff #a50e0e"
[color "status"]
	header = "#595d62"
	added = "#0d652d"
	changed = "#934900"
	untracked = "#174ea6"
	branch = "#174ea6"
	nobranch = "#a50e0e"
	# Short-format branch line (git status -sb); matches [color "branch"] and decorations.
	localBranch = "#174ea6"
	remoteBranch = "#0d652d"
[color "branch"]
	current = "#174ea6"
	local = "#202124"
	remote = "#0d652d"
[color "decorate"]
	branch = "#174ea6"
	remoteBranch = "#0d652d"
	tag = "#934900"
	stash = "#595d62"
	HEAD = "#681da8"
