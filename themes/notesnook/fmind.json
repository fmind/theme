        "heading": "#595d62",
        "icon": "#595d62",
        "separator": "#9aa0a6",
        "placeholder": "#595d62",
        "hover": "#f1f3f4",
        "backdrop": "#20212499"
      },
      "selected": {
        "accent": "#174ea6",
        "accentForeground": "#ffffff",
        "paragraph": "#202124",
        "background": "#d2e3fc",
        "border": "#174ea6",
        "heading": "#202124",
        "icon": "#174ea6",
        "separator": "#9aa0a6",
        "placeholder": "#595d62",
        "hover": "#d2e3fc",
        "backdrop": "#20212499"
