{
  "$schema": "https://raw.githubusercontent.com/streetwriters/notesnook-themes/main/schemas/v1.schema.json",
  "name": "Fmind",
  "id": "fmind",
  "version": 5,
  "license": "MIT",
  "homepage": "https://github.com/fmind/theme",
  "description": "Fmind light theme: charcoal text and dark blue accents on white.",
  "colorScheme": "light",
  "compatibilityVersion": 1,
  "authors": [
    {
      "name": "Médéric Hurier",
      "url": "https://github.com/fmind"
    }
