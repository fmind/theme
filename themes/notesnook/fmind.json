        "heading": "#595d62",
        "icon": "#595d62",
        "separator": "#9aa0a6",
        "placeholder": "#595d62",
        "hover": "#ffffff",
        "backdrop": "#20212499"
      },
      "disabled": {
        "accent": "#595d62",
        "accentForeground": "#ffffff",
        "paragraph": "#595d62",
        "background": "#f1f3f4",
