# Fmind: plain white splash with charcoal prompts and messages.
# Without these callbacks, password prompts (such as disk unlock) and boot messages stay invisible.
# API: https://gitlab.freedesktop.org/plymouth/plymouth/-/blob/main/themes/script/script.script
Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(1, 1, 1);

# Charcoal #202124 as 0-1 channels.
ink.red = 32 / 255;
ink.green = 33 / 255;
ink.blue = 36 / 255;

prompt.sprite = Sprite();
entry.sprite = Sprite();
message.sprite = Sprite();

fun show_line (sprite, text, y)
{
  # Null and "" are both false.
  if (!text)
    {
      sprite.SetOpacity(0);
      return;
    }
  image = Image.Text(text, ink.red, ink.green, ink.blue);
  sprite.SetImage(image);
  sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2, y, 10000);
  sprite.SetOpacity(1);
}

fun show_entry (prompt_text, entry_text)
{
  middle = Window.GetY() + Window.GetHeight() / 2;
  show_line(prompt.sprite, prompt_text, middle - 40);
  show_line(entry.sprite, entry_text, middle);
}

fun display_password_callback (prompt_text, bullets)
{
  hidden = "";
  for (index = 0; index < bullets; index++)
    hidden += "*";
  show_entry(prompt_text, hidden);
}

fun display_question_callback (prompt_text, entry_text)
{
  show_entry(prompt_text, entry_text);
}

fun display_normal_callback ()
{
  prompt.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
}

fun display_message_callback (text)
{
  show_line(message.sprite, text, Window.GetY() + Window.GetHeight() * 0.8);
}

fun hide_message_callback (text)
{
  message.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
