{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "includes": [
    "/*.json",
    "/*.md",
    "/*.toml",
    "/*.yml",
    "/.agents/**/*.md",
    "/.github/**/*.yml",
    "/artworks/README.md",
    "/banners/README.md",
    "/checks/*.yaml",
    "/wallpapers/README.md"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0"
  ]
}
