/* https://github.com/kingToolbox/WindTerm */
/* Layout adapted from dracula/windterm (MIT); colors and fixes by Fmind. */
ApplicationPalette {
	qproperty-link: #174ea6;
	qproperty-windowDisabled: #ffffff;
}

QWidget {
	font-family: "Google Sans";
	font-size: 9pt;
	background-color: #ffffff;
	color: #202124;
}

QAbstractButton:disabled {
	color: #595d62;
}

QAbstractItemView {
	background-color: #ffffff;
	selection-background-color: transparent;
}
QAbstractItemView:active {
	selection-background-color: #d2e3fc;
}
QAbstractItemView:!active {
	selection-background-color: #d2e3fc;
}
QAbstractItemView QLineEdit:focus {
	border: 1px solid #174ea6;
	background-color: #ffffff;
}
QAbstractItemView QProgressBar {
	max-height: 16px;
	text-align: center;
}
QAbstractItemView QToolButton:hover {
	background-color: #f1f3f4;
}
QAbstractItemView QWidget {
	background-color: transparent;
}
QAbstractItemView QScrollBar {
	background-color: #ffffff;
}
QAbstractItemView #TitleLabel, QAbstractItemView #SubtitleLabel {
	color: #595d62;
	selection-color: #595d62;
	selection-background-color: transparent;
}
QAbstractItemView::item {
	color: #202124;
	padding: 2px;
}
QAbstractItemView::indicator:unchecked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-unchecked.svg");
}
QAbstractItemView::indicator:checked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-checked.svg");
}

QAbstractSpinBox {
	border: 1px solid #9aa0a6;
	padding: 2px;
}
QAbstractSpinBox:disabled {
	border: none;
	background-color: #ffffff;
}
QAbstractSpinBox:focus {
	border: 1px solid #174ea6;
}
QAbstractSpinBox::up-button {
	width: 8px;
	padding: 0px 4px 0px 0px;
	image: url("${AppDir}/global/themes/default/images/button-up.svg");
}
QAbstractSpinBox::down-button {
	width: 8px;
	padding: 0px 4px 4px 0px;
	image: url("${AppDir}/global/themes/default/images/button-down.svg");
}

QListView::item:hover {
	background-color: #f1f3f4;
}
QListView::indicator {
	position: absolute;
	left: -4px;
	width: 24px;
	height: 24px;
}
QTreeView QLabel {
	padding-top: 2px;
	padding-bottom: 2px;
}
QListWidget, QTreeWidget, QTableWidget {
	border: 1px solid #9aa0a6;
}
QListWidget QHeaderView::section,
QTreeWidget QHeaderView::section,
QTableWidget QHeaderView::section {
	background-color: #ffffff;
}
QTableWidget::item {
	padding-top: 0px;
	padding-bottom: 0px;
}

QCheckBox::indicator {
	width: 24px;
	height: 24px;
}
QCheckBox::indicator:checked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-checked.svg");
}
QCheckBox::indicator:unchecked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-unchecked.svg");
}
QCheckBox::indicator:disabled {
	image: url("${AppDir}/global/themes/default/images/checkbox-disabled.svg");
}

QComboBox {
	border: 1px solid #9aa0a6;
	height: 21px;
	padding: 0px 2px 0px 2px;
}
QComboBox:disabled {
	border: none;
	background-color: #ffffff;
}
QComboBox:focus {
	border: 1px solid #174ea6;
}
QComboBox QLineEdit, QComboBox QLineEdit:focus {
	padding: 0px;
	border: none;
	background-color: transparent;
}
QComboBox::drop-down {
	width: 8px;
	padding-right: 4px;
	image: url("${AppDir}/global/themes/default/images/button-down.svg");
}

QDialog QFrame[frameShape = "4"] {
	color: #202124;
}

QLineEdit {
	padding: 2px;
	border: 1px solid #9aa0a6;
}
QLineEdit:disabled {
	border: none;
	background-color: #ffffff;
}
QLineEdit[PlaceHolderText = true] {
	font-style: normal;
}
QLineEdit:focus {
	border: 1px solid #174ea6;
}
QLineEdit > SwitchButton:checked {
	border: 2px solid #9aa0a6;
	padding: 4px;
	background-color: #d2e3fc;
}
QLineEdit > SideButton:hover, QLineEdit > SwitchButton:hover {
	border: +1px solid #9aa0a6;
	background-color: #f1f3f4;
}
QLineEdit > SideButton:pressed, QLineEdit > SwitchButton:pressed {
	border: +1px solid #9aa0a6;
	background-color: #d2e3fc;
}
QLineEdit > #CompleterButton {
	padding-top: 4px;
	padding-bottom: 4px;
}
QLineEdit > #CompleterButton:checked {
	border: none;
	background-color: transparent;
}

QMenuBar {
	border-bottom: +1px solid #9aa0a6;
	padding-top: 4px;
	padding-bottom: 4px;
}
QMenuBar::item:pressed, QMenuBar::item:selected {
	background-color: #d2e3fc;
}
QMenu {
	border: 1px solid #9aa0a6;
	background-color: #ffffff;
}
QMenu::item {
	padding: 6px 10px 6px 30px;
	background-color: #ffffff;
}
QMenu::item:default {
	font-weight: bold;
	color: #202124;
}
QMenu::item:disabled {
	color: #595d62;
}
QMenu::item:selected {
	border: none;
	background-color: #d2e3fc;
}
QMenu::indicator {
	width: 24px;
	height: 24px;
}
QMenu::indicator:non-exclusive:unchecked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-unchecked.svg");
}
QMenu::indicator:non-exclusive:checked {
	image: url("${AppDir}/global/themes/dige-white/images/checkbox-checked.svg");
}
QMenu::indicator:exclusive:unchecked {
	image: url("${AppDir}/global/themes/dige-white/images/radiobox-unchecked.svg");
}
QMenu::indicator:exclusive:checked {
	image: url("${AppDir}/global/themes/dige-white/images/radiobox-checked.svg");
}
QMenu::icon {
	margin: 10px;
	width: 24px;
	height: 24px;
}
QMenu::icon:checked {
	position: absolute;
	left: -200px;
}
QMenu::icon:unchecked {
	position: absolute;
	left: -200px;
}
QMenu::separator {
	height: 1px;
	background-color: #9aa0a6;
}
QMenu::right-arrow {
	position: relative;
	left: -12px;
}

QPlainTextEdit {
	border: 1px solid #9aa0a6;
	padding: 2px;
}
QPlainTextEdit:disabled {
	border: none;
	background-color: #ffffff;
}
QPlainTextEdit:focus {
	border: 1px solid #174ea6;
}

QProgressBar::chunk:!active {
	background-color: #4285f4; /* Should same as the normal background color of progressbar chunk. */
}
QProgressBar[state = "Error"]::chunk {
	background-color: #ea4335;
}

QRadioButton::indicator {
	width: 24px;
	height: 24px;
}
QRadioButton::indicator:checked {
	image: url("${AppDir}/global/themes/dige-white/images/radiobox-checked.svg");
}
QRadioButton::indicator:unchecked {
	image: url("${AppDir}/global/themes/dige-white/images/radiobox-unchecked.svg");
}
QRadioButton::indicator:disabled {
	image: url("${AppDir}/global/themes/default/images/radiobox-disabled.svg");
}

QScrollBar {
	border: none;
	background-color: transparent;
	margin: 0px 0px 0px 0px;
}
QScrollBar:horizontal {
	height: 8px;
}
QScrollBar:vertical {
	width: 8px;
}
QScrollBar::handle {
	background-color: #9aa0a6;
}
QScrollBar::handle:horizontal {
	min-width: 20px;
}
QScrollBar::handle:vertical {
	min-height: 20px;
}
QScrollBar::handle:hover {
	background-color: #9aa0a6;
}
QScrollBar::handle:disabled {
	background-color: transparent;
}
QScrollBar::add-line, QScrollBar::sub-line {
	width: 0px;
	height: 0px;
}

QSizeGrip {
	width: 0px;
	height: 0px;
}

QSplitter::handle:horizontal {
	width: +1px;
	background-color: #9aa0a6;
}
QSplitter::handle:vertical {
	height: +1px;
	background-color: #9aa0a6;
}

QStatusBar QLabel {
	padding-left: 4px;
	padding-right: 4px;
}
QStatusBar[messageLevel = "NormalMessage"], QStatusBar[messageLevel = "NormalMessage"] > * {
	color: #202124;
}
QStatusBar[messageLevel = "InfoMessage"], QStatusBar[messageLevel = "InfoMessage"] > * {
	background-color: #d2e3fc;
	color: #174ea6;
}
QStatusBar[messageLevel = "WarningMessage"], QStatusBar[messageLevel = "WarningMessage"] > * {
	background-color: #feefc3;
	color: #934900;
}
QStatusBar[messageLevel = "ErrorMessage"], QStatusBar[messageLevel = "ErrorMessage"] > * {
	background-color: #fad2cf;
	color: #a50e0e;
}

QTabBar::scroller {
	width: 0px;
}
QTabBar::tear {
	image: none;
}
QTabBar::tab {
	background-color: #ffffff;
	border-left: 1px solid #9aa0a6;
	height: 24px;
	padding-left: 8px;
}
QTabBar::tab:first {
	border-color: transparent;
}
QTabBar::tab:selected {
	color: #174ea6;
	border-right: 1px solid #9aa0a6;
	background-color: #d2e3fc;
}
QTabBar::tab:!selected:hover {
	background-color: #d2e3fc;
}

QToolBar {
	border: 2px solid transparent;
	margin-top: 2px;
	spacing: 2px;
}
QToolBar::separator {
	width: 1px;
	background-color: #9aa0a6;
}
QToolBar QLabel {
	padding: 4px;
}

QToolButton:hover {
	background-color: #f1f3f4;
}
QToolButton::menu-indicator {
	image: none;
}

QToolTip {
	font-family: "Google Sans";
	color: #202124;
	background-color: #ffffff;
	border: 1px solid #9aa0a6;
	padding: 4px;
}

AddressBar > Completer > QListView {
	border: none;
	border-bottom: 1px solid #9aa0a6;
	selection-background-color: #d2e3fc;
}
AddressBar > Completer > QListView #CategoryLabel {
	border: none;
	border-right: +1px solid #9aa0a6;
	padding-right: 2px;
}
EditorWindow #CategoryLabel {
	min-width: 130px;
	max-width: 130px;
}
TerminalWindow #CategoryLabel {
	min-width: 104px;
	max-width: 104px;
}
AddressBar > Completer > QListView #CategoryLabel[category = "Opened"] {
	color: #0d652d;
}
AddressBar > Completer > QListView #CategoryLabel[category = "Recent"] {
	color: #934900;
}
AddressBar > Completer > QListView #IconLabel {
	padding: 0px;
}
AddressBar > Completer > QListView #SubtitleLabel {
	color: #595d62;
}
AddressBar > Completer > QListView #TitleLabel {
	margin-top: 4px;
	margin-bottom: 4px;
}
AddressBar > QLineEdit {
	padding: 4px;
	border: none;
	background-color: #ffffff;
}
AddressBar > QLineEdit > BreadButton {
	background-color: transparent;
}
AddressBar > QLineEdit > BreadButton[type = "ArrowButton"], AddressBar > QLineEdit > BreadButton[type = "ChevronButton"] {
	padding-left: -4px;
	padding-right: -4px;
}
AddressBar > QLineEdit > BreadButton[type = "TextButton"] {
	padding-right: -4px;
}
AddressBar > QLineEdit > BreadButton[partial = true] {
	color: #595d62;
}
AddressBar > QLineEdit > BreadButton[important = false] {
	color: #595d62;
}
AddressBar > QLineEdit > BreadButton:hover, AddressBar > QLineEdit > BreadButton:pressed {
	background-color: #d2e3fc;
	color: #174ea6;
}

CommandPalette {
	background-color: #ffffff;
	border: +1px solid #9aa0a6;
}
CommandPalette > QLineEdit {
	font-size: 10pt;
}
CommandPalette > QLineEdit #CountLabel {
	padding-right: 2px;
	background-color: transparent;
}
CommandPalette > QListView {
	background-color: transparent;
	border: none;
}
CommandPalette > QListView::item:selected {
	background-color: #d2e3fc;
}
CommandPalette > QListView[singleLine=true] #SubtitleLabel {
	color: #595d62;
}
CommandPalette > QListView[singleLine=true] #TipLabel {
	margin-top: 4px;
	margin-bottom: 4px;
}

KitDock > QWidget,
KitDock KitPane > QLabel,
KitDock QAbstractItemView,
KitDock TabGroup,
KitDock TabGroup QWidget,
KitDock QTabBar::tab:selected,
KitDock QToolBar,
KitDock QToolBar QWidget {
	background-color: #d2e3fc;
}

KitPane > QFrame {
	border: none;
}
KitPane FilterEdit {
	background-color: transparent;
	border: none;
	border-bottom: 1px solid #9aa0a6;
}
KitPane FilterEdit:focus {
	border: none;
	border-bottom: 1px solid #174ea6;
}

#LoginWizard > QFrame {
	border: +1px solid #9aa0a6;
	background-color: #ffffff;
}
#LoginWizard > QLabel {
	color: #174ea6;
	font-size: 11pt;
	padding: 8px;
}

MessageBar {
	border-top: +1px solid #9aa0a6;
	border-bottom: +1px solid #9aa0a6;
	background-color: transparent;
}
MessageBar QWidget {
	background-color: transparent;
}
MessageBar #IconLabel[state = "Critical"] {
	qproperty-pixmap: url("${AppDir}/global/themes/default/images/critical.svg");
}
MessageBar #IconLabel[state = "Information"] {
	qproperty-pixmap: url("${AppDir}/global/themes/default/images/information.svg");
}
MessageBar #IconLabel[state = "Question"] {
	qproperty-pixmap: url("${AppDir}/global/themes/default/images/question.svg");
}
MessageBar #IconLabel[state = "Warning"] {
	qproperty-pixmap: url("${AppDir}/global/themes/default/images/warning.svg");
}
MessageBar #CloseButton {
	border: none;
	image: url("${AppDir}/global/themes/default/images/close-normal.svg");
}
MessageBar #CloseButton:hover {
	image: url("${AppDir}/global/themes/default/images/close-hover.svg");
}

#PaneGroup > QTabBar::tab {
	max-width: 160px;
}

PopupWidget, PopupWidget QWidget {
	background-color: #ffffff;
}
PopupWidget QLabel[enabled=false] {
	color: #595d62;
}

QuickBar #CloseButton, QuickBar #ConfigButton {
	border: none;
}
QuickBar #QuickButton {
	border: none;
	padding: 4px 16px 4px 16px;
}
QuickBar #ActionButton {
	padding: 0px -10px 0px 0px;
}

SearchPane > QLineEdit[state = "Error"] {
	border: 1px solid deeppink;
}

SideSeparator {
	background-color: #9aa0a6;
}

TabBar {
	qproperty-highlightBottomRight: 0px 0px;
	qproperty-highlightTopLeft: 3px 0px;
}

TabGroup QToolButton {
	background-color: transparent;
	border: none;
}
TabGroup #TextLabel {
	padding-left: 4px;
	qproperty-alignment: 'AlignVCenter | AlignLeft';
}
TabGroup #TextLabel[state = "Unactivated"] {
	font-style: normal;
	color: #595d62;
}
TabGroup #TextLabel[state = "Warning"] {
	color: #934900;
}
TabGroup #TextLabel[state = "Error"] {
	color: #a50e0e;
}
TabGroup #TextLabel[state = "Changed"] {
	color: #174ea6;
}
TabGroup #TextLabel[state = "Saved"] {
	color: #0d652d;
}
TabGroup #CloseButton[state = "Unactivated"] {
	image: url("${AppDir}/global/themes/default/images/close-unactivated.svg");
}
TabGroup #CloseButton[state = "Normal"] {
	image: url("${AppDir}/global/themes/default/images/close-normal.svg");
}
TabGroup #CloseButton[state = "Warning"] {
	image: url("${AppDir}/global/themes/default/images/close-warning.svg");
}
TabGroup #CloseButton[state = "Error"] {
	image: url("${AppDir}/global/themes/default/images/close-error.svg");
}
TabGroup #CloseButton[state = "Changed"] {
	image: url("${AppDir}/global/themes/default/images/close-changed.svg");
}
TabGroup #CloseButton[state = "Saved"] {
	image: url("${AppDir}/global/themes/default/images/close-saved.svg");
}

#ToolBarPopup QLabel {
	border: none;
	border-bottom: 1px solid darkgray;
	color: #202124;
	padding-bottom: 4px;
	margin-bottom: 6px;
}
#ToolBarPopup QToolButton[popupMode="1"] {
	margin-left: 20px;
}

TextView CompleteList {
	border: 1px solid #9aa0a6;
}
TextView CompleteList::item {
	background-color: #ffffff;
}
TextView CompleteList::item:selected {
	background-color: #d2e3fc;
}
TextView > QFrame {
	border: none;
}
TextView > QProgressBar {
	qproperty-format: "%p% (%vMB / %mMB)";
}
TextView > QAbstractScrollArea QScrollBar {
	background-color: #ffffff;
	border: none;
	margin: 0px;
}
TextView > QAbstractScrollArea QScrollBar:vertical {
	width: 16px;
}

#TextPreview {
	background-color: #ffffff;
	border-left: none;
	border-top: +2px solid #9aa0a6;
	border-right: none;
	border-bottom: +2px solid #9aa0a6;
}

TransferBar #CloseButton {
	border: none;
}

TransferLabel {
	border: none;
	border-right: +1px solid #9aa0a6;
	qproperty-progressColor: #174ea6; /* Should same as the normal background color of progressbar chunk. */
}
TransferLabel[state = "Error"] {
	qproperty-progressColor: #a50e0e; /* Should same as the error background color of progressbar chunk. */
}
TransferLabel:hover {
	background-color: #f1f3f4;
}
TransferLabel QWidget {
	background-color: transparent;
}
TransferLabel QToolButton:hover {
	background-color: #f1f3f4;
}

#ViewGroup {
	qproperty-showSelectedTabCloseButtonOnly: true;
}
#ViewGroup > QTabBar::tab {
	max-width: 200px;
	min-width: 60px;
}
#ViewGroup > QTabBar::tab:selected:!only-one {
	border-top: 2px solid #9aa0a6;
}

/* Readable native widget states absent from the reference port. */
ApplicationPalette {
    qproperty-placeholderText: #595d62;
    qproperty-placeholderTextDisabled: #595d62;
    qproperty-placeholderTextInactive: #595d62;
}
QWidget:disabled { color: #595d62; }
QAbstractItemView { selection-color: #202124; selection-background-color: #d2e3fc; }
QAbstractItemView::item:selected { color: #174ea6; background-color: #d2e3fc; }
QPushButton { color: #202124; background-color: #ffffff; border: 1px solid #9aa0a6; padding: 4px 8px; }
QPushButton:hover, QToolButton:hover { color: #174ea6; background-color: #f1f3f4; }
QPushButton:pressed, QToolButton:checked { color: #174ea6; background-color: #d2e3fc; }
QPushButton:disabled { color: #595d62; background-color: #ffffff; }
QLineEdit, QPlainTextEdit, QTextEdit { color: #202124; background-color: #ffffff; selection-color: #202124; selection-background-color: #d2e3fc; }
QProgressBar { color: #202124; background-color: #ffffff; border: 1px solid #9aa0a6; text-align: center; }
QProgressBar::chunk { background-color: #d2e3fc; }
QProgressBar::chunk:!active { background-color: #d2e3fc; }
QProgressBar[state = "Error"]::chunk { background-color: #fad2cf; }
QTabBar::tab:selected { color: #174ea6; background-color: #d2e3fc; }
TextView CompleteList::item:selected { color: #174ea6; background-color: #d2e3fc; }

QMenu::item:selected { color: #174ea6; background-color: #d2e3fc; }
