\ProvidesPackage{beamercolorthemefmind}[2026/09/14 Fmind Beamer Color Theme]
\RequirePackage{xcolor}

\definecolor{fmindbg}{HTML}{FFFFFF}
\definecolor{fmindfg}{HTML}{202124}
\definecolor{fmindaccent}{HTML}{174EA6}
\definecolor{fmindsurface}{HTML}{F1F3F4}
\definecolor{fmindmuted}{HTML}{595D62}

\setbeamercolor{normal text}{fg=fmindfg,bg=fmindbg}
\setbeamercolor{structure}{fg=fmindaccent}
\setbeamercolor{palette primary}{fg=fmindfg,bg=fmindsurface}
\setbeamercolor{palette secondary}{fg=fmindaccent,bg=fmindsurface}
\setbeamercolor{palette tertiary}{fg=fmindfg,bg=fmindsurface}
\setbeamercolor{item}{fg=fmindaccent}
\mode<all>
