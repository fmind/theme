# Fmind color scheme for bobthefish
function bobthefish_colors -S -d 'Define Fmind color scheme for bobthefish'
  set -x color_initial_segment_exit     202124 f1f3f4 --bold
  set -x color_initial_segment_private  202124 f1f3f4
  set -x color_initial_segment_su       202124 f1f3f4 --bold
  set -x color_initial_segment_jobs     202124 f1f3f4

  set -x color_path                     202124 f1f3f4
  set -x color_path_basename            174ea6 f1f3f4 --bold
  set -x color_path_nowrite             a50e0e f1f3f4
  set -x color_repo                     0d652d f1f3f4
  set -x color_repo_work_tree           202124 f1f3f4
  set -x color_repo_dirty               934900 f1f3f4
  set -x color_repo_staged              174ea6 f1f3f4
end
