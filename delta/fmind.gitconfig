# fmind — generated by render.py, do not edit
# source: palettes/fmind.yaml
# Include from ~/.gitconfig, or paste into its [delta] section.

[delta]
    syntax-theme = "ansi"
    minus-style = syntax "#43080e"
    minus-emph-style = syntax "#540d13"
    plus-style = syntax "#1a211a"
    plus-emph-style = syntax "#222b22"
    hunk-header-style = "#6c776a"
    file-style = "#26fed9"
    line-numbers-zero-style = "#6c776a"
