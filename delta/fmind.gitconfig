# fmind — generated by render.py, do not edit
# source: palettes/fmind.yaml
# Include from ~/.gitconfig, or paste into its [delta] section.

[delta]
    syntax-theme = "ansi"
    minus-style = syntax "#451113"
    minus-emph-style = syntax "#551418"
    plus-style = syntax "#092821"
    plus-emph-style = syntax "#0a3229"
    hunk-header-style = "#7e8a7b"
    file-style = "#26fed9"
    line-numbers-zero-style = "#7e8a7b"
