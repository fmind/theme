# https://github.com/tsujan/Kvantum/blob/master/Kvantum/doc/Theme-Config
[%General]
author=Médéric Hurier
comment=White Fmind surfaces with readable semantic states
respect_DE=false
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
menu_separator_height=8
tooltip_shadow_depth=0
reduce_window_opacity=0
reduce_menu_opacity=0
x11drag=false
alt_mnemonic=true
animate_states=false
left_tabs=true
joined_inactive_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
scroll_width=14
scroll_arrows=true
slider_width=6
slider_handle_width=18
slider_handle_length=18
splitter_width=6
check_size=18
progressbar_thickness=24
transient_scrollbar=false
spread_progressbar=false
combo_as_lineedit=true
no_inactiveness=false

[GeneralColors]
window.color=#ffffff
inactive.window.color=#ffffff
base.color=#ffffff
inactive.base.color=#ffffff
alt.base.color=#ffffff
inactive.alt.base.color=#ffffff
button.color=#ffffff
light.color=#ffffff
mid.light.color=#9aa0a6
dark.color=#ffffff
mid.color=#9aa0a6
shadow.color=#202124
highlight.color=#d2e3fc
inactive.highlight.color=#d2e3fc
tooltip.base.color=#ffffff
text.color=#202124
inactive.text.color=#202124
window.text.color=#202124
inactive.window.text.color=#202124
button.text.color=#202124
disabled.text.color=#595d62
tooltip.text.color=#202124
highlight.text.color=#202124
inactive.highlight.text.color=#202124
link.color=#174ea6
link.visited.color=#681da8
progress.indicator.text.color=#202124
progress.inactive.indicator.text.color=#202124

[Hacks]
respect_darkness=false
disabled_icon_opacity=100
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
no_selection_tint=true

[PanelButtonCommand]
frame=true
frame.element=control
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=control
indicator.element=arrow
indicator.size=10
text.normal.color=#202124
text.focus.color=#202124
text.press.color=#202124
text.toggle.color=#202124
text.normal.inactive.color=#202124
text.focus.inactive.color=#202124
text.press.inactive.color=#202124
text.toggle.inactive.color=#202124
text.shadow=false
text.bold=false
text.margin=true
text.margin.top=5
text.margin.bottom=5
text.margin.left=7
text.margin.right=7
text.iconspacing=6

[PanelButtonTool]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface
indicator.element=mdi

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior.element=surface

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=entry
interior.element=entry

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[Focus]
inherits=PanelButtonCommand
frame.element=focus
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface

[LineEdit]
inherits=PanelButtonCommand
frame.element=entry
interior.element=entry

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
inherits=PanelButtonCommand
indicator.element=arrow

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=control
interior.element=control
indicator.element=tab

[TabFrame]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface

[TabBarFrame]
inherits=PanelButtonCommand
frame=false
interior.element=surface

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=12

[HeaderSection]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface
indicator.element=arrow

[SizeGrip]
inherits=PanelButtonCommand
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior.element=surface
indicator.element=toolbar
indicator.size=4

[ToolbarButton]
inherits=PanelButtonCommand

[ToolbarComboBox]
inherits=PanelButtonCommand

[ToolbarLineEdit]
inherits=PanelButtonCommand
frame.element=entry
interior.element=entry

[Slider]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=cursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress

[ItemView]
inherits=PanelButtonCommand
frame=false
interior.element=selection
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Splitter]
inherits=PanelButtonCommand
frame=false
interior.element=surface
indicator.element=splitter
indicator.size=6

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle
indicator.size=0

[Menu]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior.element=selection
indicator.element=menuitem
min_height=26

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior.element=surface

[MenuBarItem]
inherits=PanelButtonCommand
frame=false
interior.element=selection

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=surface
indicator.element=mdi
indicator.size=14

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down

[GroupBox]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface

[ToolTip]
inherits=PanelButtonCommand
frame.element=surface
interior.element=surface

[StatusBar]
inherits=PanelButtonCommand
frame=false
interior.element=surface

[Window]
inherits=PanelButtonCommand
frame=false
interior.element=surface

[Dialog]
inherits=PanelButtonCommand
frame=false
interior.element=surface
