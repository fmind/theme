  "palette": {
    "background": "#ffffff",
    "foreground": "#202124",
    "comment": "#595d62",
    "blue": "#174ea6",
    "green": "#0d652d",
    "orange": "#934900",
    "purple": "#681da8",
    "red": "#a50e0e",
