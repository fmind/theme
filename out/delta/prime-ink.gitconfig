# Prime Ink — generated by render.py, do not edit
# source: palettes/prime-ink.yaml
# Include from ~/.gitconfig, or paste into its [delta] section.

[delta]
    syntax-theme = "ansi"
    minus-style = syntax "#781518"
    minus-emph-style = syntax "#a11f24"
    plus-style = syntax "#5e7565"
    plus-emph-style = syntax "#7e9c87"
    hunk-header-style = "#006a39"
    file-style = "#63fca3"
    line-numbers-zero-style = "#006a39"
