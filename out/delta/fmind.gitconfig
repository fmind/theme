# Fmind — generated by render.py, do not edit
# source: palettes/fmind.yaml
# Include from ~/.gitconfig, or paste into its [delta] section.

[delta]
    syntax-theme = "ansi"
    minus-style = syntax "#7a000f"
    minus-emph-style = syntax "#a30017"
    plus-style = syntax "#617461"
    plus-emph-style = syntax "#839c83"
    hunk-header-style = "#24682c"
    file-style = "#3afdb5"
    line-numbers-zero-style = "#24682c"
