# Vivado Fmind Light Color Theme
set_param gui.theme "Light"
add_gui_custom_color -name "editor_background" -color "#ffffff"
add_gui_custom_color -name "editor_foreground" -color "#202124"
add_gui_custom_color -name "editor_keyword" -color "#174ea6"
add_gui_custom_color -name "editor_comment" -color "#595d62"
add_gui_custom_color -name "editor_string" -color "#0d652d"
add_gui_custom_color -name "editor_number" -color "#934900"
add_gui_custom_color -name "editor_selection" -color "#d2e3fc"
