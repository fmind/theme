# https://github.com/zyedidia/micro/blob/master/runtime/help/colors.md
color-link default "#202124,#ffffff"
color-link comment "#595d62"
color-link identifier "#202124"
color-link identifier.class "#174ea6"
color-link identifier.macro "#681da8"
color-link constant "#934900"
color-link constant.string "#0d652d"
color-link constant.string.url "underline #174ea6"
color-link constant.specialChar "#174ea6"
color-link statement "bold #174ea6"
color-link symbol "#202124"
color-link symbol.tag "#174ea6"
color-link preproc "#681da8"
color-link type "#681da8"
color-link type.keyword "bold #174ea6"
color-link special "#00636d"
color-link underlined "underline #174ea6"
color-link error "#a50e0e"
color-link todo "bold #934900"
color-link selection "#202124,#d2e3fc"
color-link statusline "#202124,#d2e3fc"
color-link statusline.inactive "#595d62,#f1f3f4"
color-link statusline.suggestions "#202124,#f1f3f4"
color-link tabbar "#595d62,#f1f3f4"
color-link tabbar.active "bold #202124,#fbbc04"
color-link indent-char "#9aa0a6"
color-link line-number "#595d62,#ffffff"
color-link current-line-number "bold #174ea6,#f1f3f4"
color-link gutter-info "#00636d"
color-link gutter-error "#a50e0e"
color-link gutter-warning "#934900"
color-link diff-added "#0d652d"
color-link diff-modified "#934900"
color-link diff-deleted "#a50e0e"
color-link cursor-line ",#f1f3f4"
color-link color-column ",#f1f3f4"
color-link scrollbar "#9aa0a6"
color-link divider "#9aa0a6"
color-link message "#00636d,#ffffff"
color-link error-message "#a50e0e,#ffffff"
color-link match-brace "bold #202124,#feefc3"
color-link hlsearch "#202124,#fbbc04"
color-link tab-error "#a50e0e,#fad2cf"
color-link trailingws "#a50e0e,#fad2cf"
